    {
      "id": "U58S4s8ks9GvKewccUBVv",
      "type": "text",
      "x": 1460.0446428571424,
      "y": 1037.6780133928569,
      "width": 595.2517700195312,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
